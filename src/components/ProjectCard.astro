---
import type { Lang, Project } from '../types/content';
import { t } from '../i18n/utils';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const href = lang === 'en'
  ? `/en/projects/${t(project.slug, 'en')}`
  : `/proyectos/${t(project.slug, 'es')}`;
---

<a href={href} class="project-card">
  <div class="project-card__image">
    <img src={project.coverImage} alt={t(project.images[0]?.alt ?? { es: '', en: '' }, lang)} loading="lazy" />
  </div>
  <div class="project-card__info">
    <h3 class="project-card__title">{t(project.title, lang)}</h3>
    <p class="project-card__meta">
      <span>{t(project.category, lang)}</span>
      <span class="project-card__year">{project.year}</span>
    </p>
  </div>
</a>

<style>
  .project-card {
    display: block;
    transition: opacity 0.2s;
  }

  .project-card:hover {
    opacity: 0.7;
  }

  .project-card__image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #f0f0f0;
    margin-bottom: var(--spacing-sm);
  }

  .project-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card__title {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-black);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .project-card__meta {
    display: flex;
    gap: var(--spacing-sm);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .project-card__year {
    color: var(--color-text-secondary);
  }
</style>
