---
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutData from '../data/about.json';
import { t, tArray } from '../i18n/utils';
import type { AboutData } from '../types/content';

const lang = 'es';
const about = aboutData as AboutData;
---

<BaseLayout title={t(about.heading, lang)} lang={lang}>
  <section class="about">
    <div class="about__header container">
      <h1 class="heading-lg">{t(about.heading, lang)}</h1>
    </div>

    <div class="about__statement container">
      <p class="heading-md">{t(about.statement, lang)}</p>
    </div>

    <div class="about__content container">
      <div class="about__portrait">
        <img src={about.portrait.src} alt={t(about.portrait.alt, lang)} />
      </div>
      <div class="about__bio">
        {tArray(about.bio, lang).map((paragraph) => (
          <p>{paragraph}</p>
        ))}

        <div class="about__contact">
          <h3 class="heading-sm">{lang === 'es' ? 'CONTACTO' : 'CONTACT'}</h3>
          <a href={`mailto:${about.contact.email}`}>{about.contact.email}</a>
          <p>{t(about.contact.location, lang)}</p>
          <div class="about__social">
            {about.contact.social.map((link) => (
              <a href={link.url} target="_blank" rel="noopener noreferrer">{link.platform}</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding-top: calc(var(--header-height) + var(--spacing-lg));
  }

  .about__header {
    margin-bottom: var(--spacing-lg);
    text-align: right;
  }

  .about__statement {
    margin-bottom: var(--spacing-xl);
  }

  .about__content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    align-items: start;
  }

  @media (max-width: 768px) {
    .about__content {
      grid-template-columns: 1fr;
    }
  }

  .about__portrait img {
    width: 100%;
    height: auto;
  }

  .about__bio {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  .about__contact {
    margin-top: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .about__contact h3 {
    margin-bottom: 0.5rem;
  }

  .about__contact a {
    transition: opacity 0.2s;
  }

  .about__contact a:hover {
    opacity: 0.5;
  }

  .about__social {
    display: flex;
    gap: var(--spacing-sm);
    margin-top: 0.5rem;
  }

  .about__social a {
    font-weight: var(--font-weight-black);
    text-transform: uppercase;
    font-size: var(--text-sm);
  }
</style>
